SPRING_PROFILES_ACTIVE=prod
PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:5432/dna_futsal
DATABASE_USERNAME=dna_futsal
DATABASE_PASSWORD=change-me
DB_MAX_POOL_SIZE=10

FRONTEND_BASE_URL=https://app.dnafutsal.com.br
CORS_ALLOWED_ORIGINS=https://app.dnafutsal.com.br
APP_TIMEZONE=America/Sao_Paulo

SPORTS_CACHE_MAX_ENTRIES=2000
IDENTITY_CACHE_MAX_ENTRIES=10000
LOGIN_ATTEMPT_CACHE_MAX_ENTRIES=50000

# Gere com: openssl rand -base64 64
JWT_SECRET=replace-with-a-random-secret-of-at-least-64-characters

SPORTS_API_BASE_URL=https://dna-scrapper.onrender.com
SPORTS_CONNECT_TIMEOUT=PT5S
SPORTS_READ_TIMEOUT=PT60S
SPORTS_EVENT_CACHE_TTL=PT1H
SPORTS_TEAM_CACHE_TTL=PT1H
SPORTS_SNAPSHOT_CACHE_TTL=PT10M
SPORTS_INCLUDE_PERSONAL_DATA=true
NEWS_API_BASE_URL=https://news-api.example.com

MAIL_FROM_EMAIL=no-reply@dnafutsal.com.br
MAIL_FROM_NAME=DNA Futsal
BREVO_ENABLED=true
BREVO_API_KEY=replace-me

# Fallback SMTP. Use outro provedor/infra, não o mesmo upstream do Brevo.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_AUTH=true
SMTP_STARTTLS=true
